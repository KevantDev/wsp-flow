generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SUBADMIN
}

enum TenantPlan {
  FREE_TRIAL
  BASIC
  PRO
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING_PAYMENT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderSource {
  WHATSAPP_BOT
  MANUAL_DASHBOARD
}

enum SessionStatus {
  DISCONNECTED
  SCAN_QR
  CONNECTING
  CONNECTED
}

enum MessageSender {
  CUSTOMER
  BOT
  AGENT
}

enum PaymentMethod {
  CULQI_CARD
  CULQI_YAPE
  MERCADOPAGO
  CASH_ON_DELIVERY
  BANK_TRANSFER
  CULQI_PENDING
  PENDING
}

enum PaymentStatus {
  PENDING
  AWAITING_CASH
  PAID
  REFUNDED
  FAILED
}

enum BotKeywordMatchType {
  EXACT
  CONTAINS
  REGEX
}

model Plan {
  id              String      @id @default(uuid())
  code            TenantPlan  @unique
  name            String
  description     String?
  price           Float       @default(0)
  currency        String      @default("PEN")
  billingPeriod   String      @default("MONTHLY")
  maxProducts     Int         @default(20)
  maxBroadcasts   Int         @default(50)
  maxUsers        Int         @default(1)
  hasMercadoPago  Boolean     @default(false)
  hasAiBot        Boolean     @default(true)
  hasCustomThemes Boolean     @default(false)
  hasPdfCatalog   Boolean     @default(true)
  features        String[]    @default([])
  badgeColor      String      @default("zinc")
  isPopular       Boolean     @default(false)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenants         Tenant[]

  @@map("plans")
}

model Tenant {
  id              String        @id @default(uuid())
  name            String
  slug            String        @unique
  logoUrl         String?
  plan            TenantPlan    @default(FREE_TRIAL)
  planRef         Plan?         @relation(fields: [plan], references: [code])
  status          TenantStatus  @default(ACTIVE)
  maxProducts     Int           @default(50)
  maxBroadcasts   Int           @default(500)
  culqiPublicKey  String?
  culqiPrivateKey String?
  mpPublicKey     String?
  mpAccessToken   String?
  mpRefreshToken  String?
  mpUserId        String?
  mpConnectedAt   DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  users            User[]
  categories       Category[]
  products         Product[]
  orders           Order[]
  chatSessions     ChatSession[]
  whatsappSessions WhatsAppSession[]
  config           CompanyConfig?
  botKeywords      BotKeyword[]
  broadcasts       BroadcastCampaign[]
  auditLogs        AuditLog[]

  @@map("tenants")
}

model User {
  id            String      @id @default(uuid())
  tenantId      String?
  tenant        Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email         String      @unique
  passwordHash  String
  fullName      String
  phoneNumber   String?
  role          Role        @default(SUBADMIN)
  isActive      Boolean     @default(true)
  avatarUrl     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  assignedChats       ChatSession[]
  ordersHandled       Order[]       @relation("HandledBy")
  cashCollectedOrders Order[]       @relation("CashCollectedBy")
  auditLogs           AuditLog[]

  @@index([tenantId])
  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  orderIndex  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("categories")
}

model Product {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  sku            String
  description    String
  price          Float
  costPrice      Float?
  stock          Int            @default(0)
  minStockAlert  Int            @default(5)
  isAvailable    Boolean        @default(true)
  videoUrl       String?
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  images         ProductImage[]
  orderItems     OrderItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([categoryId])
  @@index([sku])
  @@map("products")
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl   String
  altText    String?
  isPrimary  Boolean  @default(false)
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("product_images")
}

model WhatsAppSession {
  id                String        @id @default(uuid())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionName       String        @default("default")
  phoneNumber       String?
  status            SessionStatus @default(DISCONNECTED)
  qrCode            String?
  isAutoReplyActive Boolean       @default(true)
  welcomeMessage    String?
  outOfStockMessage String?
  updatedAt         DateTime      @updatedAt
  createdAt         DateTime      @default(now())

  @@unique([tenantId, sessionName])
  @@index([tenantId])
  @@map("whatsapp_sessions")
}

model ChatSession {
  id              String        @id @default(uuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerPhone   String
  customerName    String?
  isBotActive     Boolean       @default(true)
  isArchived      Boolean       @default(false)
  lastInteraction DateTime      @default(now())
  unreadCount     Int           @default(0)
  assignedUserId  String?
  assignedUser    User?         @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  messages        ChatMessage[]
  orders          Order[]

  @@index([tenantId])
  @@index([customerPhone])
  @@index([isArchived])
  @@map("chat_sessions")
}

model ChatMessage {
  id            String        @id @default(uuid())
  chatSessionId String
  chatSession   ChatSession   @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  sender        MessageSender
  senderName    String?
  content       String
  mediaUrl      String?
  mediaType     String?       @default("text")
  whatsappMsgId String?       @unique
  isRead        Boolean       @default(false)
  createdAt     DateTime      @default(now())

  @@index([chatSessionId])
  @@map("chat_messages")
}

model Order {
  id                  String        @id @default(uuid())
  tenantId            String
  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderNumber         String
  chatSessionId       String?
  chatSession         ChatSession?  @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)
  customerName        String
  customerPhone       String
  customerAddress     String?
  status              OrderStatus   @default(PENDING)
  source              OrderSource   @default(WHATSAPP_BOT)
  subtotal            Float
  deliveryFee         Float         @default(0.0)
  total               Float
  paymentMethod           PaymentMethod @default(PENDING)
  paymentStatus           PaymentStatus @default(PENDING)
  culqiChargeId           String?
  culqiRefundId           String?
  mercadoPagoPaymentId    String?
  mercadoPagoPreferenceId String?
  paidAt                  DateTime?
  refundedAt          DateTime?
  cashCollectedById   String?
  cashCollectedBy     User?         @relation("CashCollectedBy", fields: [cashCollectedById], references: [id], onDelete: SetNull)
  notes               String?
  handledById         String?
  handledBy           User?         @relation("HandledBy", fields: [handledById], references: [id], onDelete: SetNull)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  items               OrderItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([status])
  @@index([customerPhone])
  @@index([paymentMethod])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String
  unitPrice   Float
  quantity    Int
  subtotal    Float

  @@map("order_items")
}

model BotKeyword {
  id        String              @id @default(uuid())
  tenantId  String
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  keyword   String
  matchType BotKeywordMatchType @default(EXACT)
  response  String
  mediaUrl  String?
  action    String?
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())

  @@unique([tenantId, keyword])
  @@index([tenantId])
  @@map("bot_keywords")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model CompanyConfig {
  id                  String   @id @default(uuid())
  tenantId            String   @unique
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyName         String   @default("WSP Flow Commerce")
  businessDescription String   @default("Tienda digital de comercio electrónico con atención y ventas automatizadas 24/7.")
  systemPrompt        String   @default("Eres Luna, la asesora comercial y asistente virtual de ventas experta de la tienda. Tu objetivo es asesorar a los clientes con calidez y precisión, responder dudas sobre productos, verificar stock real, enviar fotos o videos cuando lo soliciten y concretar pedidos de compra de forma fluida.")
  shippingPolicy      String   @default("Envíos express en 24 a 48 horas hábiles.")
  paymentMethods      String   @default("Transferencia bancaria, Yape, tarjetas de crédito/débito y pago contra entrega.")
  workingHours        String   @default("Lunes a Sábado de 09:00 a 20:00")
  address             String   @default("Av. Principal 1234, Centro")
  aiModel             String   @default("gpt-4o-mini")
  aiTemperature       Float    @default(0.7)
  antiBanDelayMinMs   Int      @default(1500)
  antiBanDelayMaxMs   Int      @default(3500)
  historyMessageLimit Int      @default(15)
  pickupStoreAddress  String   @default("Av. Larco 743, Miraflores, Lima")
  pickupStoreHours    String   @default("Lunes a Sábados de 09:00 a 20:00")
  deliveryZone1Price  Float    @default(10.0)
  deliveryZone2Price  Float    @default(15.0)
  deliveryZone3Price  Float    @default(20.0)
  deliveryProvincePrice Float  @default(15.0)
  freeShippingThreshold Float? @default(0.0)
  storeTheme            String? // JSON: { templateId, accentColor, fontFamily, productLayout }
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  @@map("company_config")
}

model BroadcastCampaign {
  id               String               @id @default(uuid())
  tenantId         String
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title            String
  messageTemplate  String
  mediaUrl         String?
  attachPdfCatalog Boolean              @default(false)
  status           String               @default("DRAFT") // "DRAFT", "SENDING", "PAUSED", "COMPLETED", "CANCELLED"
  targetSegment    String               @default("ALL_CUSTOMERS") // "ALL_CUSTOMERS", "FREQUENT_BUYERS", "PENDING_ORDERS", "RECENT_CONTACTS"
  totalRecipients  Int                  @default(0)
  sentCount        Int                  @default(0)
  failedCount      Int                  @default(0)
  deliveredCount   Int                  @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  recipients       BroadcastRecipient[]

  @@index([tenantId])
  @@map("broadcast_campaigns")
}

model BroadcastRecipient {
  id            String            @id @default(uuid())
  campaignId    String
  campaign      BroadcastCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerPhone String
  customerName  String?
  renderedText  String
  status        String            @default("QUEUED") // "QUEUED", "SENDING", "SENT", "FAILED"
  errorMessage  String?
  sentAt        DateTime?
  createdAt     DateTime          @default(now())

  @@index([campaignId])
  @@index([customerPhone])
  @@map("broadcast_recipients")
}
